# PlantCare AI Backend Environment Configuration
APP_NAME=PlantCare AI Backend
APP_VERSION=0.1.0
ENVIRONMENT=development

# Comma-separated frontend origins allowed via CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Upload & preprocessing constraints
MAX_IMAGE_SIZE_MB=5
IMAGE_INPUT_SIZE=224

# Model artifact paths (relative to project root or absolute)
MODEL_PATH=ai-model/trained_model/plant_disease_model.keras
LABELS_PATH=ai-model/trained_model/class_names.json

# Prediction confidence settings
CONFIDENCE_THRESHOLD=0.60
TOP_K_ALTERNATIVES=3
