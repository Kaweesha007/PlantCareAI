# ==============================================================================
# PlantCare AI - Root .gitignore
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
*/venv/
*/.venv/
*/env/

# Node Dependencies & Package Managers
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs & Generated Assets
dist/
dist-ssr/
build/
*/dist/
*.local

# Python Bytecode & Cache Files
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest & Coverage Artifacts
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Datasets (Raw, Processed, and Experimental Leaf Image Collections)
ai-model/dataset/
dataset/
datasets/
data/raw/
data/processed/
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Environment Variables & Secrets (Preserve .env.example templates)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# IDE & Editor Specific Files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# OS Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary Scratch Files & Logs
logs/
*.log
scratch/
temp/
tmp/

# ==============================================================================
# Whitelist / Explicit Inclusions (Crucial Project Artifacts)
# ==============================================================================
!ai-model/trained_model/plant_disease_model.keras
!ai-model/trained_model/plant_gatekeeper_model.keras
!ai-model/trained_model/*.json
!backend/app/data/*.json
!backend/requirements.txt
!frontend/package.json
!frontend/package-lock.json
